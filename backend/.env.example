PORT=3000
INSTANCE_ID=local
NODE_ENV=development

# MongoDB Atlas - direct connection without SRV
DATABASE=mongodb://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@HOST_00:27017,HOST_01:27017,HOST_02:27017/evoting?tls=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority
DATABASE_LOCAL=mongodb://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@HOST_00:27017,HOST_01:27017,HOST_02:27017/evoting?tls=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority
DATABASE_PASSWORD=
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Authentication
JWT_SECRET=change_this_to_a_secure_secret_min_32_chars
JWT_EXPIRE=24h

# Encryption
ENCRYPTION_KEY=change_this_to_a_32_byte_key_here

# Optional: require verified + whitelisted voters
STRICT_VOTER_ELIGIBILITY=false

# Worker settings
VOTE_WORKER_CONCURRENCY=5
